        "DB_PASSWORD": "AVNS_QRtU05ismu7ATHSyaTg",
        "APP_KEY": "base64:rqSvOI3E3a0m2m6q2rhGomV7Cjw40cInyw/0AUcS+tE=",
        "APP_URL": "https://alrabie-dryfruits-cashews.vercel.app",
        "DB_SSL_VERIFY": "false"
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
